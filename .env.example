# Copy to .env.local for local development, and set the same variable in your hosting
# dashboard (Vercel: Project Settings > Environment Variables).
# VITE_* values are embedded in the public JS bundle: never put secrets (e.g. the Telegram token) here.

# Google Apps Script web app URL (Deploy > Manage deployments > Web app URL)
VITE_API_URL=https://script.google.com/macros/s/<DEPLOYMENT_ID>/exec

# Supabase public values
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
